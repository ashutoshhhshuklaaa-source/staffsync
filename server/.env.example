# StaffSync HRMS - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file with secrets into version control.

# Application Environment ('development', 'production', or 'test')
NODE_ENV=development

# Server Port (defaults to 5000 if not specified; Render automatically assigns PORT in production)
PORT=5000

# MongoDB Connection URI (Supports MONGO_URI or MONGODB_URI)
# Local MongoDB Community Server:
MONGO_URI=mongodb://127.0.0.1:27017/staffsync
# Production MongoDB Atlas Cluster Example:
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster_address>.mongodb.net/staffsync?retryWrites=true&w=majority&appName=StaffSync
# MONGODB_URI is also supported as an alias on cloud platforms.

# Frontend Client URL(s) for CORS (Supports CLIENT_URL or FRONTEND_URL; supports comma-separated origins)
CLIENT_URL=http://localhost:5173
# FRONTEND_URL=https://staffsync-app.onrender.com

# JWT Authentication Secret & Expiration
# Recommendation: Generate a secure 256-bit secret using: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_cryptographically_secure_secret_string
JWT_EXPIRES_IN=1h
